# Apache (hosting de IONOS). Sustituye al .htaccess de WordPress en la carpeta de
# barakaldomakers.org. Las redirecciones solo afectan a las rutas de esta web: Moodle,
# descargas/ y cualquier otra carpeta que ya haya en el servidor siguen como estaban.

# index.html primero (la web nueva); index.php para las aplicaciones PHP de las subcarpetas
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Como hacía el .htaccess de WordPress: pasa la cabecera Authorization a PHP (para Moodle u
  # otras aplicaciones PHP de las subcarpetas). No corta el resto de reglas.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Rutas de la web nueva: /, /es/, /eu/, sus archivos y las redirecciones de la web antigua
  RewriteCond %{REQUEST_URI} ^/((es|eu|_next|images|sobre-nosotros|microscopio-openflexure|mini-cnc-pcb)(/.*)?|index\.html|404\.html|robots\.txt|sitemap\.xml|icon\.png)?$
  # a https://barakaldomakers.org (sin www). IONOS recomienda mirar el puerto, no %{HTTPS}.
  RewriteCond %{SERVER_PORT} !=443 [OR]
  RewriteCond %{HTTP_HOST} !^barakaldomakers\.org$ [NC]
  RewriteRule ^ https://barakaldomakers.org%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Cabeceras de seguridad, solo en las rutas de la web nueva (las mismas de arriba)
  <If "%{REQUEST_URI} =~ m#^/((es|eu|_next|images|sobre-nosotros|microscopio-openflexure|mini-cnc-pcb)(/.*)?|index\.html|404\.html|robots\.txt|sitemap\.xml|icon\.png)?$#">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Todo sale del propio dominio. 'unsafe-inline' hace falta: Next exporta scripts y estilos en línea.
    # Al conectar Formspree, añadir https://formspree.io a form-action (y a connect-src si se envía con fetch).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </If>
  # Sin HSTS de momento: vale para todo el dominio, Moodle incluido, y no sabemos si este va por https.

  # Los archivos de _next/static llevan una huella en el nombre: no cambian nunca
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
